# Copy this file to .env.local and fill in real values.

# Path to the SQLite database file
DATABASE_PATH=./data/sentriq.db

# 32-byte (64 hex char) key used for AES-256-GCM encryption of stored secrets (LLM API keys)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Auth.js session secret
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Required in production: the public URL Sentriq is served from (e.g. https://sentriq.example.com)
# Used by Auth.js for callback URLs and secure cookies. Not needed for local dev.
# AUTH_URL=
